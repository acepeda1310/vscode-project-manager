{
	"name": "project-manager-fork",
	"displayName": "Project Manager",
	"description": "Easily switch between projects",
	"version": "13.1.1",
	"publisher": "adriancepeda",
	"engines": {
		"vscode": "^1.78.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"git",
		"project",
		"folder",
		"workspace",
		"switch",
		"manage",
		"mercurial",
		"svn",
		"multi-root ready"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"icon": "docs/images/icon.png",
	"license": "SEE LICENSE IN LICENSE.md",
	"homepage": "https://github.com/alefragnani/vscode-project-manager/blob/master/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/alefragnani/vscode-project-manager.git"
	},
	"bugs": {
		"url": "https://github.com/alefragnani/vscode-project-manager/issues"
	},
	"sponsor": {
		"url": "https://github.com/sponsors/alefragnani"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension",
	"l10n": "./l10n",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "project-manager-fork",
					"title": "%projectManagerFork.activitybar.title%",
					"icon": "docs/images/project-manager-side-bar.svg"
				}
			]
		},
		"views": {
			"project-manager-fork": [
				{
					"id": "projectsExplorerForkFavorites",
					"name": "%projectManagerFork.views.favorites.name%"
				},
				{
					"id": "projectsExplorerForkGit",
					"name": "%projectManagerFork.views.git.name%",
					"when": "projectManagerFork.canShowTreeViewGit"
				},
				{
					"id": "projectsExplorerForkSVN",
					"name": "%projectManagerFork.views.svn.name%",
					"when": "projectManagerFork.canShowTreeViewSVN"
				},
				{
					"id": "projectsExplorerForkAny",
					"name": "%projectManagerFork.views.any.name%",
					"when": "projectManagerFork.canShowTreeViewAny"
				},
				{
					"id": "projectsExplorerForkMercurial",
					"name": "%projectManagerFork.views.mercurial.name%",
					"when": "projectManagerFork.canShowTreeViewMercurial"
				},
				{
					"id": "projectsExplorerForkVSCode",
					"name": "%projectManagerFork.views.vscode.name%",
					"when": "projectManagerFork.canShowTreeViewVSCode"
				},
				{
					"id": "projectManagerForkHelpAndFeedback",
					"name": "%projectManagerFork.views.helpAndFeedback.name%",
					"visibility": "collapsed"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "projectsExplorerForkFavorites",
				"contents": "%projectManagerFork.viewsWelcome.favorites.contents.whenEmpty%",
				"when": "workbenchState == empty"
			},
			{
				"view": "projectsExplorerForkFavorites",
				"contents": "%projectManagerFork.viewsWelcome.favorites.contents.whenNotEmpty%",
				"when": "workbenchState != empty"
			},
			{
				"view": "projectsExplorerForkGit",
				"contents": "%projectManagerFork.viewsWelcome.git.contents%"
			}
		],
		"commands": [
			{
				"command": "projectManagerFork.saveProject",
				"title": "%projectManagerFork.commands.saveProject.title%",
				"icon": "$(save)"
			},
			{
				"command": "projectManagerFork.newProject",
				"title": "%projectManagerFork.commands.newProject.title%",
				"icon": "$(add)"
			},
			{
				"command": "_projectManagerFork.editProject",
				"title": "%projectManagerFork.commands.editProject.title%",
				"icon": "$(edit)"
			},
			{
				"command": "projectManagerFork.listProjects",
				"title": "%projectManagerFork.commands.listProjects.title%"
			},
			{
				"command": "projectManagerFork.listProjectsNewWindow",
				"title": "%projectManagerFork.commands.listProjectsNewWindow.title%"
			},
			{
				"command": "projectManagerFork.editProjects",
				"title": "%projectManagerFork.commands.editProjects.title%",
				"icon": "$(edit)"
			},
			{
				"command": "_projectManagerFork.viewAsTags#sideBarFavorites",
				"title": "%projectManagerFork.commands.viewAsTags#sideBarFavorites.title%",
				"icon": "$(list-tree)",
				"enablement": "projectManagerFork.viewAsList"
			},
			{
				"command": "_projectManagerFork.viewAsList#sideBarFavorites",
				"title": "%projectManagerFork.commands.viewAsList#sideBarFavorites.title%",
				"icon": "$(list-flat)",
				"enablement": "!projectManagerFork.viewAsList"
			},
			{
				"command": "_projectManagerFork.sortBySaved#sideBarFavorites",
				"title": "%projectManagerFork.commands.sortBySaved#sideBarFavorites.title%",
				"enablement": "projectManagerFork.sortBy != Saved"
			},
			{
				"command": "_projectManagerFork.sortByName#sideBarFavorites",
				"title": "%projectManagerFork.commands.sortByName#sideBarFavorites.title%",
				"enablement": "projectManagerFork.sortBy != Name"
			},
			{
				"command": "_projectManagerFork.sortByPath#sideBarFavorites",
				"title": "%projectManagerFork.commands.sortByPath#sideBarFavorites.title%",
				"enablement": "projectManagerFork.sortBy != Path"
			},
			{
				"command": "_projectManagerFork.sortByRecent#sideBarFavorites",
				"title": "%projectManagerFork.commands.sortByRecent#sideBarFavorites.title%",
				"enablement": "projectManagerFork.sortBy != Recent"
			},
			{
				"command": "projectManagerFork.filterProjectsByTag",
				"title": "%projectManagerFork.commands.filterProjectsByTag.title%"
			},
			{
				"command": "projectManagerFork.filterProjectsByTag#sideBar",
				"title": "%projectManagerFork.commands.filterProjectsByTag#sideBar.title%",
				"icon": "$(tag)"
			},
			{
				"command": "projectManagerFork.listFavoriteProjects#sideBarFavorites",
				"title": "%projectManagerFork.commands.listFavoriteProjects#sideBarFavorites.title%",
				"icon": "$(search)"
			},
			{
				"command": "projectManagerFork.refreshProjects",
				"title": "%projectManagerFork.commands.refreshProjects.title%"
			},
			{
				"command": "projectManagerFork.refreshVSCodeProjects",
				"title": "%projectManagerFork.commands.refreshVSCodeProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "projectManagerFork.listVSCodeProjects#sideBarVSCode",
				"title": "%projectManagerFork.commands.listVSCodeProjects#sideBarVSCode.title%",
				"icon": "$(search)"
			},
			{
				"command": "projectManagerFork.refreshGitProjects",
				"title": "%projectManagerFork.commands.refreshGitProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "projectManagerFork.listGitProjects#sideBarGit",
				"title": "%projectManagerFork.commands.listGitProjects#sideBarGit.title%",
				"icon": "$(search)"
			},
			{
				"command": "projectManagerFork.refreshSVNProjects",
				"title": "%projectManagerFork.commands.refreshSVNProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "projectManagerFork.listSVNProjects#sideBarSVN",
				"title": "%projectManagerFork.commands.listSVNProjects#sideBarSVN.title%",
				"icon": "$(search)"
			},
			{
				"command": "projectManagerFork.refreshAnyProjects",
				"title": "%projectManagerFork.commands.refreshAnyProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "projectManagerFork.listAnyProjects#sideBarAny",
				"title": "%projectManagerFork.commands.listAnyProjects#sideBarAny.title%",
				"icon": "$(search)"
			},
			{
				"command": "projectManagerFork.refreshMercurialProjects",
				"title": "%projectManagerFork.commands.refreshMercurialProjects.title%",
				"icon": "$(refresh)"
			},
			{
				"command": "projectManagerFork.listMercurialProjects#sideBarMercurial",
				"title": "%projectManagerFork.commands.listMercurialProjects#sideBarMercurial.title%",
				"icon": "$(search)"
			},
			{
				"command": "projectManagerFork.openSettings#sideBarFavorites",
				"title": "%projectManagerFork.commands.openSettings#sideBarFavorites.title%"
			},
			{
				"command": "projectManagerFork.openSettings#sideBarVSCode",
				"title": "%projectManagerFork.commands.openSettings#sideBarVSCode.title%"
			},
			{
				"command": "projectManagerFork.openSettings#sideBarGit",
				"title": "%projectManagerFork.commands.openSettings#sideBarGit.title%"
			},
			{
				"command": "projectManagerFork.openSettings#sideBarSVN",
				"title": "%projectManagerFork.commands.openSettings#sideBarSVN.title%"
			},
			{
				"command": "projectManagerFork.openSettings#sideBarAny",
				"title": "%projectManagerFork.commands.openSettings#sideBarAny.title%"
			},
			{
				"command": "projectManagerFork.openSettings#sideBarMercurial",
				"title": "%projectManagerFork.commands.openSettings#sideBarMercurial.title%"
			},
			{
				"command": "_projectManagerFork.open",
				"title": "%projectManagerFork.commands.open.title%"
			},
			{
				"command": "_projectManagerFork.openInNewWindow",
				"title": "%projectManagerFork.commands.openInNewWindow.title%",
				"icon": "$(link-external)"
			},
			{
				"command": "projectManagerFork.addToWorkspace#sideBar",
				"title": "%projectManagerFork.commands.addToWorkspace#sideBar.title%"
			},
			{
				"command": "_projectManagerFork.revealInFinder#sideBar",
				"title": "%projectManagerFork.commands.revealInFinder#sideBar.title%"
			},
			{
				"command": "_projectManagerFork.revealInExplorer#sideBar",
				"title": "%projectManagerFork.commands.revealInExplorer#sideBar.title%"
			},
			{
				"command": "_projectManagerFork.revealInFileManager#sideBar",
				"title": "%projectManagerFork.commands.revealInFileManager#sideBar.title%"
			},
			{
				"command": "projectManagerFork.addToWorkspace",
				"title": "%projectManagerFork.commands.addToWorkspace.title%"
			},
			{
				"command": "_projectManagerFork.deleteProject",
				"title": "%projectManagerFork.commands.deleteProject.title%"
			},
			{
				"command": "_projectManagerFork.renameProject",
				"title": "%projectManagerFork.commands.renameProject.title%"
			},
			{
				"command": "_projectManagerFork.editTags",
				"title": "%projectManagerFork.commands.editTags.title%"
			},
			{
				"command": "projectManagerFork.whatsNew",
				"title": "%projectManagerFork.commands.whatsNew.title%"
			},
			{
				"command": "_projectManagerFork.whatsNewContextMenu",
				"title": "%projectManagerFork.commands.whatsNewContextMenu.title%"
			},
			{
				"command": "projectManagerFork.addToFavorites",
				"title": "%projectManagerFork.commands.addToFavorites.title%"
			},
			{
				"command": "_projectManagerFork.toggleProjectEnabled",
				"title": "%projectManagerFork.commands.toggleProjectEnabled.title%"
			},
			{
				"command": "projectManagerFork.hideGitWelcome",
				"title": "%projectManagerFork.commands.hideGitWelcome.title%"
			},
			{
				"command": "projectManagerFork.showGitWelcome",
				"title": "%projectManagerFork.commands.showGitWelcome.title%"
			},
			{
				"command": "_projectManagerFork.openFolderWelcome",
				"title": "%projectManagerFork.commands.openFolderWelcome.title%"
			},
			{
				"command": "projectManagerFork.supportProjectManager",
				"title": "%projectManagerFork.commands.supportProjectManager.title%"
			},
			{
				"command": "_projectManagerFork.openSideBar",
				"title": "%projectManagerFork.commands.openSideBar.title%"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "_projectManagerFork.editProject",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.open",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.openInNewWindow",
					"when": "false"
				},
				{
					"command": "projectManagerFork.addToWorkspace#sideBar",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.revealInFinder#sideBar",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.revealInExplorer#sideBar",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.revealInFileManager#sideBar",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.deleteProject",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.renameProject",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.editTags",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.viewAsTags#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.viewAsList#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.sortBySaved#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.sortByName#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.sortByPath#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.sortByRecent#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "projectManagerFork.filterProjectsByTag#sideBar",
					"when": "false"
				},
				{
					"command": "projectManagerFork.listFavoriteProjects#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "projectManagerFork.listVSCodeProjects#sideBarVSCode",
					"when": "false"
				},
				{
					"command": "projectManagerFork.listGitProjects#sideBarGit",
					"when": "false"
				},
				{
					"command": "projectManagerFork.listSVNProjects#sideBarSVN",
					"when": "false"
				},
				{
					"command": "projectManagerFork.listAnyProjects#sideBarAny",
					"when": "false"
				},
				{
					"command": "projectManagerFork.listMercurialProjects#sideBarMercurial",
					"when": "false"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarFavorites",
					"when": "false"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarVSCode",
					"when": "false"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarSVN",
					"when": "false"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarGit",
					"when": "false"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarAny",
					"when": "false"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarMercurial",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.whatsNewContextMenu",
					"when": "false"
				},
				{
					"command": "projectManagerFork.hideGitWelcome",
					"when": "false"
				},
				{
					"command": "projectManagerFork.showGitWelcome",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.openFolderWelcome",
					"when": "false"
				},
				{
					"command": "_projectManagerFork.openSideBar",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "projectManagerFork.newProject",
					"when": "view == projectsExplorerForkFavorites",
					"group": "navigation@9"
				},
				{
					"command": "projectManagerFork.saveProject",
					"when": "view == projectsExplorerForkFavorites",
					"group": "navigation@10"
				},
				{
					"command": "projectManagerFork.editProjects",
					"when": "view == projectsExplorerForkFavorites",
					"group": "navigation@11"
				},
				{
					"command": "_projectManagerFork.viewAsTags#sideBarFavorites",
					"when": "view == projectsExplorerForkFavorites && projectManagerFork.viewAsList",
					"group": "navigation@12"
				},
				{
					"command": "_projectManagerFork.viewAsList#sideBarFavorites",
					"when": "view == projectsExplorerForkFavorites && !projectManagerFork.viewAsList",
					"group": "navigation@13"
				},
				{
					"command": "projectManagerFork.listFavoriteProjects#sideBarFavorites",
					"when": "view == projectsExplorerForkFavorites",
					"group": "navigation@14"
				},
				{
					"command": "projectManagerFork.filterProjectsByTag#sideBar",
					"when": "view == projectsExplorerForkFavorites",
					"group": "navigation@14"
				},
				{
					"submenu": "projectManagerFork.sideBar.favorites.title",
					"when": "view == projectsExplorerForkFavorites",
					"group": "1_projectManagerFork"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarFavorites",
					"when": "view == projectsExplorerForkFavorites",
					"group": "2_projectManagerFork"
				},
				{
					"command": "projectManagerFork.showGitWelcome",
					"when": "view == projectsExplorerForkFavorites && projectManagerFork.hiddenGitWelcome",
					"group": "2_projectManagerFork"
				},
				{
					"command": "projectManagerFork.listVSCodeProjects#sideBarVSCode",
					"when": "view == projectsExplorerForkVSCode",
					"group": "navigation@10"
				},
				{
					"command": "projectManagerFork.refreshVSCodeProjects",
					"when": "view == projectsExplorerForkVSCode",
					"group": "navigation@11"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarVSCode",
					"when": "view == projectsExplorerForkVSCode",
					"group": "2_projectManagerFork"
				},
				{
					"command": "projectManagerFork.listGitProjects#sideBarGit",
					"when": "view == projectsExplorerForkGit",
					"group": "navigation@10"
				},
				{
					"command": "projectManagerFork.refreshGitProjects",
					"when": "view == projectsExplorerForkGit",
					"group": "navigation@11"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarGit",
					"when": "view == projectsExplorerForkGit",
					"group": "2_projectManagerFork"
				},
				{
					"command": "projectManagerFork.listSVNProjects#sideBarSVN",
					"when": "view == projectsExplorerForkSVN",
					"group": "navigation@10"
				},
				{
					"command": "projectManagerFork.refreshSVNProjects",
					"when": "view == projectsExplorerForkSVN",
					"group": "navigation@11"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarSVN",
					"when": "view == projectsExplorerForkSVN",
					"group": "2_projectManagerFork"
				},
				{
					"command": "projectManagerFork.listAnyProjects#sideBarAny",
					"when": "view == projectsExplorerForkAny",
					"group": "navigation@10"
				},
				{
					"command": "projectManagerFork.refreshAnyProjects",
					"when": "view == projectsExplorerForkAny",
					"group": "navigation@11"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarAny",
					"when": "view == projectsExplorerForkAny",
					"group": "2_projectManagerFork"
				},
				{
					"command": "projectManagerFork.listMercurialProjects#sideBarMercurial",
					"when": "view == projectsExplorerForkMercurial",
					"group": "navigation@10"
				},
				{
					"command": "projectManagerFork.refreshMercurialProjects",
					"when": "view == projectsExplorerForkMercurial",
					"group": "navigation@11"
				},
				{
					"command": "projectManagerFork.openSettings#sideBarMercurial",
					"when": "view == projectsExplorerForkMercurial",
					"group": "2_projectManagerFork"
				}
			],
			"view/item/context": [
				{
					"command": "_projectManagerFork.editProject",
					"when": "view == projectsExplorerForkFavorites && viewItem == ProjectNodeKind",
					"group": "inline@1"
				},
				{
					"command": "_projectManagerFork.editProject",
					"when": "view == projectsExplorerForkFavorites && viewItem == ProjectNodeKind",
					"group": "favorites@0"
				},
				{
					"command": "_projectManagerFork.openInNewWindow",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "inline@2"
				},
				{
					"command": "_projectManagerFork.open",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "navigation"
				},
				{
					"command": "_projectManagerFork.openInNewWindow",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "navigation"
				},
				{
					"command": "_projectManagerFork.revealInFinder#sideBar",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isMac",
					"group": "navigation@2"
				},
				{
					"command": "_projectManagerFork.revealInExplorer#sideBar",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows",
					"group": "navigation@2"
				},
				{
					"command": "_projectManagerFork.revealInFileManager#sideBar",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isLinux",
					"group": "navigation@2"
				},
				{
					"command": "_projectManagerFork.deleteProject",
					"when": "view == projectsExplorerForkFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_projectManagerFork.renameProject",
					"when": "view == projectsExplorerForkFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_projectManagerFork.editTags",
					"when": "view == projectsExplorerForkFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "_projectManagerFork.toggleProjectEnabled",
					"when": "view == projectsExplorerForkFavorites && viewItem == ProjectNodeKind",
					"group": "favorites"
				},
				{
					"command": "projectManagerFork.addToWorkspace#sideBar",
					"when": "view =~ /projectsExplorerFork(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "workspace"
				},
				{
					"command": "projectManagerFork.addToFavorites",
					"when": "view =~ /projectsExplorerFork(VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind",
					"group": "workspace"
				}
			],
			"extension/context": [
				{
					"command": "_projectManagerFork.whatsNewContextMenu",
					"group": "projectManagerFork",
					"when": "extension == adriancepeda.project-manager-fork && extensionStatus == installed"
				}
			],
